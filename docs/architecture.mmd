%% permitd architecture, drawn from the code as of 2026-10-25
flowchart TD
    agent["calling agent / MCP client (e.g. Claude Code)"]
    approver["human approver, second terminal"]
    host["embedding host: a brain runtime such as brainfoundry-nous, or any Python process"]
    disk["on disk: permitd.db, permitd.db.secret, permitd_audit.jsonl"]

    subgraph model_sg["Permit model and signing"]
        permit["Permit dataclass: proposed / approved / denied / executed / expired, public() hides token [src/permitd/permit.py]"]
        binding["canonical_args + binding_hash = sha256(tool + sorted-key JSON args) [src/permitd/binding.py]"]
        secret["HMAC secret: load_or_create_secret (0600 file) or PERMITD_SECRET env [src/permitd/kernel.py]"]
        proto["PermitStore protocol: create / get / update / burn (CAS) / list [src/permitd/store.py]"]
        sqlite["SqliteStore: durable rows, burn = one atomic UPDATE WHERE status=approved [src/permitd/store.py]"]
        memory["MemoryStore: in-process, lock-guarded, for tests [src/permitd/store.py]"]
    end

    subgraph flow_sg["Proposal and approval flow"]
        kernel["PermitKernel.propose / pending / approve / deny: mints HMAC-SHA256 token over id.binding.approved_at, double TTL [src/permitd/kernel.py]"]
    end

    subgraph gate_sg["Execution gate"]
        gate["Gate: GREEN / YELLOW / RED registry, @gate.tool, call() returns GateResult never raises [src/permitd/gate.py]"]
        guard["egress guard scan_outbound: credential regexes, env-value match, entropy backstop [src/permitd/guard.py]"]
        execute["PermitKernel.verify_and_burn + execute: signature recomputes, binding matches, unexpired, wins burn, then runner(**args) [src/permitd/kernel.py]"]
    end

    subgraph audit_sg["Audit log"]
        auditlog["AuditLog.log: append-only JSONL, prev = sha256 of previous line, fsync, dropped counter [src/permitd/audit.py]"]
        verify["AuditLog.verify / tip / tail + summarize_args [src/permitd/audit.py]"]
    end

    subgraph surface_sg["CLI and integration surface"]
        cli["permitd CLI: pending, show, approve, deny, audit -n / --verify / --tip [src/permitd/cli.py]"]
        paths["default_paths: db -> db.secret + _audit.jsonl, --db / PERMITD_DB [src/permitd/gate.py]"]
        mcp["MCP example server: read_notes GREEN, write_note RED, pending_permits [examples/mcp_server/server.py]"]
        pkg["hatchling package 0.2.0, zero deps, extras mcp / dev, console script permitd [pyproject.toml]"]
        actions["GitHub Actions: pytest matrix 3.10 to 3.14; trusted-publish to PyPI on v* tags [.github/workflows/]"]
        tests["64 pytest tests across kernel, store, binding, gate, guard, audit, cli [tests/]"]
    end

    agent -->|"calls tools over MCP stdio"| mcp
    host -->|"embeds Gate(db=) or PermitKernel directly"| gate
    mcp -->|"gate.call(name, args, permit_id)"| gate
    pkg -->|"exposes entry point"| cli
    pkg -->|"ships"| mcp
    actions -->|"runs"| tests
    tests -->|"exercise"| kernel
    tests -->|"exercise"| gate

    gate -->|"scans args before any non-GREEN call"| guard
    gate -->|"RED without permit_id: proposes"| kernel
    gate -->|"RED with permit_id: executes"| execute
    gate -->|"logs GREEN runs and refusals"| auditlog
    gate -->|"derives store, secret, audit paths"| paths

    approver -->|"reads full args, approves or denies"| cli
    cli -->|"resolves same files"| paths
    cli -->|"approve mints token, deny kills it"| kernel
    cli -->|"tail, verify chain, print tip"| verify

    kernel -->|"creates and transitions"| permit
    kernel -->|"binds to"| binding
    kernel -->|"signs with"| secret
    kernel -->|"persists through"| proto
    execute -->|"recomputes signature with"| secret
    execute -->|"rechecks tool + args against"| binding
    execute -->|"atomic burn, one caller wins"| proto
    execute -->|"logs executed, failed, refused"| auditlog
    kernel -->|"logs proposed, approved, denied"| auditlog
    proto -->|"default"| sqlite
    proto -->|"tests"| memory
    verify -->|"walks"| auditlog

    sqlite -->|"permit rows"| disk
    secret -->|"0600 secret file"| disk
    auditlog -->|"chained lines"| disk
